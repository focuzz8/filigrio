# Model provider for the live eval (`deno task eval`, which loads this via --env-file).
# Copy to `.env` and edit. Var resolution is in src/model.ts.

# --- Local llama.cpp / any OpenAI-compatible server (the default probe).
AI_PROVIDER=llama
# The API address. AI_BASE_URL wins over LLAMA_BASE_URL and the built-in default;
# edit this one line if the server's port moves.
AI_BASE_URL=http://127.0.0.1:45285/v1
AI_MODEL_ID=openai/qwen35

# --- Hosted provider (e.g. Cerebras) instead: comment the block above, uncomment this.
# AI_PROVIDER=cerebras                     # `cerebras` uses api.cerebras.ai/v1 by default
# PROVIDER_API_KEY=sk-...                  # its presence selects "remote" over local
# AI_MODEL_ID=zai-glm-4.7                  # e.g. zai-glm-4.7 | gpt-oss-120b | gemma-4-31b
# AI_BASE_URL=https://host/v1              # only to override a provider not in the table

# --- The checkout the tasks in tasks.json ask about (or pass --repo <path>).
REFLEX_REPO=/path/to/reflex_monorepo
